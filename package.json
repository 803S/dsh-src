{
  "name": "@lihua_dis/dsh-src",
  "description": "DSH SRC 漏洞挖掘模式：以探索链路记录目标、线索、资产与漏洞，并在 Web 中可视化展示。",
  "version": "0.1.0-local.125",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./src": "./lib/src.js",
    "./storage-sqlite": "./lib/storage-sqlite.js",
    "./preset-root": "./lib/preset-root.js",
    "./ui-src": "./lib/ui-src.js",
    "./ui-src/package.json": "./package.json",
    "./client": "./lib/ui-src.client.js",
    "./invariant": "./lib/invariant.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./src-web-search-provider": "./lib/src/web-search-provider.js",
    "./src-subagent": "./lib/src-subagent.js",
    "./src-domain-admin": "./lib/src-domain-admin.js",
    "./src-egress": "./lib/src-egress.js",
    "./src-bash-executor": "./lib/src-bash-executor.js"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.cjs",
    "lib/**/*.mjs",
    "lib/**/*.py",
    "preset/src-hunter/**",
    "cordis.patch.yml",
    "tools/**",
    "images/**",
    "README.md",
    "LICENSE",
    "scripts/*.mjs",
    "scripts/*.py",
    "scripts/*.sh",
    "tests/blind-range.mjs",
    "capabilities.yaml.example",
    "docs/*.md"
  ],
  "license": "MIT",
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-invariants": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-bash-sandbox": "0.1.0-rc.8"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-invariants": {
      "optional": true
    },
    "@deepseek-ai/dsh-bash-sandbox": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test tests/target-context.test.mjs tests/egress-lifecycle-audit.test.mjs tests/egress-tool-results.test.mjs tests/egress-burp-passive.test.mjs tests/egress-delegation.test.mjs tests/egress-capability-test.test.mjs tests/egress-capability-inventory.test.mjs tests/egress-proof-approval.test.mjs tests/egress-fofa.test.mjs tests/egress-browser-adapter.test.mjs tests/egress-browser-sessions.test.mjs tests/egress-mcp-client.test.mjs tests/egress-web-fetch.test.mjs tests/egress-goal-lifecycle.test.mjs tests/egress-onboarding.test.mjs tests/deployment.test.mjs tests/egress-gate.test.mjs tests/src.integration.test.mjs tests/browser-loop.test.mjs tests/blind-eval.test.mjs tests/laya-keyless.test.mjs tests/project-defects.test.mjs tests/laya-wait.test.mjs tests/laya-repair.test.mjs tests/jev-service.test.mjs tests/jev-policy.test.mjs tests/quality-contracts.test.mjs",
    "eval:blind": "node scripts/run-blind-eval.mjs",
    "ui-src:test": "node scripts/test-ui-settings.mjs",
    "ui-src:typecheck": "node src/dsh-client-ui-src/node_modules/typescript/bin/tsc -p src/dsh-client-ui-src/tsconfig.json",
    "ui-src:build": "cd src/dsh-client-ui-src && node node_modules/tsdown/dist/run.mjs && cp dist/index.js ../../lib/ui-src.client.js"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm": "0.1.0-rc.8",
    "@deepseek-ai/dsh-session": "0.1.0-rc.8",
    "@deepseek-ai/dsh-storage": "0.1.0-rc.8",
    "@deepseek-ai/dsh-storage-domain": "0.1.0-rc.8",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.8",
    "js-yaml": "^4.3.2",
    "zod": "4.4.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/803S/dsh-src.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "src",
    "bug-bounty",
    "vulnerability",
    "pentest",
    "security",
    "burp-suite",
    "agent"
  ],
  "author": "lihua_dis",
  "engines": {
    "node": ">=24"
  }
}
